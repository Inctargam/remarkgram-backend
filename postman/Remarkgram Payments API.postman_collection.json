{
  "info": {
    "_postman_id": "5b6ce797-f61f-4ec1-b4e7-22763355bd2d",
    "name": "Remarkgram Payments API",
    "description": "Public plans and authenticated payment checkout, status, and history endpoints exposed by the API Gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "plan_id", "value": "1", "type": "string" },
    { "key": "payment_id", "value": "11111111-1111-4111-8111-111111111111", "type": "string" },
    { "key": "idempotency_key", "value": "7b96a443-8b33-41cf-9bd9-2f57b720d39e", "type": "string" },
    { "key": "page_number", "value": "1", "type": "string" },
    { "key": "page_size", "value": "10", "type": "string" }
  ],
  "item": [
    {
      "name": "Plans",
      "item": [
        {
          "name": "GET /plans",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns a plan array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/plans",
              "host": ["{{base_url}}"],
              "path": ["plans"]
            },
            "description": "Returns the public plan catalog ordered by plan ID."
          }
        }
      ]
    },
    {
      "name": "Payments",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
      },
      "item": [
        {
          "name": "POST /payments/checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201', () => pm.response.to.have.status(201));",
                  "pm.test('returns the checkout result', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.paymentId).to.be.a('string');",
                  "  pm.expect(body.status).to.be.a('string');",
                  "  pm.expect(body).to.have.property('checkoutUrl');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text",
                "description": "UUID v4 reused only when retrying the identical checkout request."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": {{plan_id}},\n  \"provider\": \"STRIPE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/payments/checkout",
              "host": ["{{base_url}}"],
              "path": ["payments", "checkout"]
            }
          }
        },
        {
          "name": "GET /payments/:paymentId/status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns payment status', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.paymentId).to.eql(pm.variables.get('payment_id'));",
                  "  pm.expect(body.status).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/payments/:paymentId/status",
              "host": ["{{base_url}}"],
              "path": ["payments", ":paymentId", "status"],
              "variable": [{ "key": "paymentId", "value": "{{payment_id}}" }]
            }
          }
        },
        {
          "name": "GET /payments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns a paginated payment list', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.items).to.be.an('array');",
                  "  pm.expect(body.pageNumber).to.eql(Number(pm.variables.get('page_number')));",
                  "  pm.expect(body.pageSize).to.eql(Number(pm.variables.get('page_size')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/payments?pageNumber={{page_number}}&pageSize={{page_size}}",
              "host": ["{{base_url}}"],
              "path": ["payments"],
              "query": [
                { "key": "pageNumber", "value": "{{page_number}}" },
                { "key": "pageSize", "value": "{{page_size}}" }
              ]
            }
          }
        }
      ]
    }
  ]
}

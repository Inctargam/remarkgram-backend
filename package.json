{
  "name": "remarkgram-backend",
  "type": "module",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:api-gateway": "nest build api-gateway",
    "build:files": "nest build files",
    "build:posts": "nest build posts",
    "build:user-accounts": "nest build user-accounts",
    "grpc:generate": "pnpm run grpc:generate:files && pnpm run grpc:generate:posts && pnpm run grpc:generate:user-accounts",
    "grpc:generate:files": "mkdir -p libs/contracts/files-grpc/src/generated && grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=libs/contracts/files-grpc/src/generated --ts_proto_opt=nestJs=true,esModuleInterop=true,importSuffix=.js --proto_path=libs/contracts/files-grpc/src/proto libs/contracts/files-grpc/src/proto/files.proto",
    "grpc:generate:posts": "mkdir -p libs/contracts/posts-grpc/src/generated && grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=libs/contracts/posts-grpc/src/generated --ts_proto_opt=nestJs=true,esModuleInterop=true,importSuffix=.js --proto_path=libs/contracts/posts-grpc/src/proto libs/contracts/posts-grpc/src/proto/posts.proto",
    "grpc:generate:user-accounts": "mkdir -p libs/contracts/user-accounts-grpc/src/generated && grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=libs/contracts/user-accounts-grpc/src/generated --ts_proto_opt=nestJs=true,esModuleInterop=true,importSuffix=.js --proto_path=libs/contracts/user-accounts-grpc/src/proto libs/contracts/user-accounts-grpc/src/proto/user-accounts.proto",
    "grpc-win:generate": "pnpm run grpc-win:generate:files && pnpm run grpc-win:generate:posts && pnpm run grpc-win:generate:user-accounts",
    "grpc-win:generate:files": "node -e \"require('node:fs').mkdirSync('libs/contracts/files-grpc/src/generated',{recursive:true})\" && grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=.\\node_modules\\.bin\\protoc-gen-ts_proto.cmd --ts_proto_out=libs/contracts/files-grpc/src/generated --ts_proto_opt=nestJs=true,esModuleInterop=true,importSuffix=.js --proto_path=libs/contracts/files-grpc/src/proto libs/contracts/files-grpc/src/proto/files.proto",
    "grpc-win:generate:posts": "node -e \"require('node:fs').mkdirSync('libs/contracts/posts-grpc/src/generated',{recursive:true})\" && grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=.\\node_modules\\.bin\\protoc-gen-ts_proto.cmd --ts_proto_out=libs/contracts/posts-grpc/src/generated --ts_proto_opt=nestJs=true,esModuleInterop=true,importSuffix=.js --proto_path=libs/contracts/posts-grpc/src/proto libs/contracts/posts-grpc/src/proto/posts.proto",
    "grpc-win:generate:user-accounts": "node -e \"require('node:fs').mkdirSync('libs/contracts/user-accounts-grpc/src/generated',{recursive:true})\" && grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=.\\node_modules\\.bin\\protoc-gen-ts_proto.cmd --ts_proto_out=libs/contracts/user-accounts-grpc/src/generated --ts_proto_opt=nestJs=true,esModuleInterop=true,importSuffix=.js --proto_path=libs/contracts/user-accounts-grpc/src/proto libs/contracts/user-accounts-grpc/src/proto/user-accounts.proto",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "nest start",
    "start:api-gateway": "cross-env NODE_ENV=production node dist/apps/api-gateway/apps/api-gateway/src/main.js",
    "start:files": "cross-env NODE_ENV=production node dist/apps/files/apps/files/src/main.js",
    "start:posts": "cross-env NODE_ENV=production node dist/apps/posts/apps/posts/src/main.js",
    "start:user-accounts": "cross-env NODE_ENV=production node dist/apps/user-accounts/apps/user-accounts/src/main.js",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:dev:api-gateway": "cross-env NODE_ENV=development nest start api-gateway --watch",
    "start:dev:files": "cross-env NODE_ENV=development nest start files --watch",
    "start:dev:posts": "cross-env NODE_ENV=development nest start posts --watch",
    "start:dev:user-accounts": "cross-env NODE_ENV=development nest start user-accounts --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/apps/api-gateway/apps/api-gateway/src/main.js",
    "prisma:files:generate": "prisma generate --config apps/files/prisma.config.ts",
    "prisma:files:studio": "prisma studio --config apps/files/prisma.config.ts",
    "prisma:files:migrate:dev": "prisma migrate dev --config apps/files/prisma.config.ts",
    "prisma:files:migrate:create": "prisma migrate dev --create-only --config apps/files/prisma.config.ts",
    "prisma:files:migrate:deploy": "prisma migrate deploy --config apps/files/prisma.config.ts",
    "prisma:files:status": "prisma migrate status --config apps/files/prisma.config.ts",
    "prisma:posts:generate": "prisma generate --config apps/posts/prisma.config.ts",
    "prisma:posts:studio": "prisma studio --config apps/posts/prisma.config.ts",
    "prisma:posts:migrate:dev": "prisma migrate dev --config apps/posts/prisma.config.ts",
    "prisma:posts:migrate:create": "prisma migrate dev --create-only --config apps/posts/prisma.config.ts",
    "prisma:posts:migrate:deploy": "prisma migrate deploy --config apps/posts/prisma.config.ts",
    "prisma:posts:status": "prisma migrate status --config apps/posts/prisma.config.ts",
    "prisma:user-accounts:generate": "prisma generate --config apps/user-accounts/prisma.config.ts",
    "prisma:user-accounts:studio": "prisma studio --config apps/user-accounts/prisma.config.ts",
    "prisma:user-accounts:migrate:dev": "prisma migrate dev --config apps/user-accounts/prisma.config.ts",
    "prisma:user-accounts:migrate:create": "prisma migrate dev --create-only --config apps/user-accounts/prisma.config.ts",
    "prisma:user-accounts:migrate:deploy": "prisma migrate deploy --config apps/user-accounts/prisma.config.ts",
    "prisma:user-accounts:status": "prisma migrate status --config apps/user-accounts/prisma.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "test": "vitest run --exclude \"apps/**/*.e2e-spec.ts\"",
    "test:watch": "vitest --exclude \"apps/**/*.e2e-spec.ts\"",
    "test:cov": "vitest run --exclude \"apps/**/*.e2e-spec.ts\" --coverage",
    "test:debug": "vitest --inspectBrk --run --no-file-parallelism --exclude \"apps/**/*.e2e-spec.ts\"",
    "test:e2e": "vitest run --exclude \"apps/**/*.spec.ts\"",
    "create:posts": "node scripts/create-posts.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/s3-presigned-post": "^3.1100.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.26",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/passport-github2": "^1.2.9",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.3",
    "openid-client": "^6.8.4",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@swc/core": "^1.15.40",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "grpc-tools": "^1.13.1",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}

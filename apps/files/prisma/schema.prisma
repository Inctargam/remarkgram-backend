generator client {
  provider        = "prisma-client"
  output          = "../src/infrastructure/prisma/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum FileUploadStatus {
  PENDING
  COMPLETED
  REJECTED
  RESERVED
  ATTACHED
}

enum ImageUploadOperationKind {
  RESERVE
  ATTACH
  RELEASE
}

model File {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               Int
  objectKey            String           @unique
  originalFilename     String
  contentType          String
  size                 Int
  uploadStatus         FileUploadStatus @default(PENDING)
  uploadExpiresAt      DateTime         @db.Timestamptz
  uploadedAt           DateTime?        @db.Timestamptz
  reservationId        String?          @db.Uuid
  reservationExpiresAt DateTime?        @db.Timestamptz
  deletedAt            DateTime?        @db.Timestamptz
  createdAt            DateTime         @default(now()) @db.Timestamptz
  updatedAt            DateTime         @updatedAt @db.Timestamptz

  @@index([uploadExpiresAt], where: { uploadStatus: "PENDING", deletedAt: null })
  @@index([uploadedAt], where: { uploadStatus: "COMPLETED", reservationId: null, deletedAt: null })
  @@index([updatedAt], where: { uploadStatus: "REJECTED", deletedAt: null })
  @@index([userId, reservationId])
  @@map("files")
}

model ImageUploadOperationReceipt {
  operationId   String                   @id @db.Uuid
  kind          ImageUploadOperationKind
  userId        Int
  reservationId String                   @db.Uuid
  uploadIds     String[]                 @db.Uuid
  createdAt     DateTime                 @default(now()) @db.Timestamptz

  // Для одного резервирования может быть успешно выполнена только одна команда каждого вида.
  // Вместе с operationId это выявляет повторное использование идентификаторов и конкурирующие шаги.
  @@unique([kind, reservationId])
  @@map("image_upload_operation_receipts")
}

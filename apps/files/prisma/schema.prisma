generator client {
  provider        = "prisma-client"
  output          = "../src/infrastructure/prisma/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum FileUploadStatus {
  PENDING
  COMPLETED
  REJECTED
  ATTACHED
}

enum PostImageAttachmentStatus {
  ATTACHED
  CANCELLED
}

model File {
  id                             String                        @id @default(uuid()) @db.Uuid
  userId                         Int
  objectKey                      String                        @unique
  originalFilename               String
  contentType                    String
  size                           Int
  uploadStatus                   FileUploadStatus              @default(PENDING)
  uploadExpiresAt                DateTime                      @db.Timestamptz
  uploadedAt                     DateTime?                     @db.Timestamptz
  postImageAttachmentOperationId String?                       @db.Uuid
  avatarAttachmentOperationId    String?                       @unique @db.Uuid
  deletedAt                      DateTime?                     @db.Timestamptz
  createdAt                      DateTime                      @default(now()) @db.Timestamptz
  updatedAt                      DateTime                      @updatedAt @db.Timestamptz
  postImageAttachmentOperation   PostImageAttachmentOperation? @relation(fields: [postImageAttachmentOperationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Очистка выбирает и новые загрузки, и ранее помеченные файлы для повторного удаления.
  @@index([uploadExpiresAt], where: { uploadStatus: "PENDING" })
  @@index([uploadedAt], where: { uploadStatus: "COMPLETED", postImageAttachmentOperationId: null })
  @@index([updatedAt], where: { uploadStatus: "REJECTED" })
  @@index([userId, postImageAttachmentOperationId])
  @@map("files")
}

model PostImageAttachmentOperation {
  id          String                    @id @db.Uuid
  userId      Int
  fileIdsHash String                    @db.VarChar(64)
  status      PostImageAttachmentStatus
  createdAt   DateTime                  @default(now()) @db.Timestamptz
  updatedAt   DateTime                  @updatedAt @db.Timestamptz
  files       File[]

  @@map("post_image_attachment_operations")
}

enum InboxStatus {
  RECEIVED
  PROCESSED
  DEAD
}

model InboxEvents {
  eventId     String      @id @map("event_id") @db.Uuid //защита идемпотентности
  eventType   String      @map("event_type")
  payload     Json
  status      InboxStatus @default(RECEIVED)
  attempts    Int         @default(0)
  receivedAt  DateTime    @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime?   @map("processed_at") @db.Timestamptz
  availableAt DateTime    @default(now()) @map("available_at") @db.Timestamptz
  lastError   String?     @map("last_error")

  @@index([status, availableAt])
  @@map("inbox_events")
}

enum FileDeletionJobStatus {
  PENDING
  DONE
  DEAD
}

model FileDeletionJob {
  fileId      String                @id @map("file_id") @db.Uuid
  objectKey   String                @map("object_key")
  status      FileDeletionJobStatus @default(PENDING)
  attempts    Int                   @default(0)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  doneAt      DateTime?             @map("done_at") @db.Timestamptz
  availableAt DateTime              @map("available_at") @db.Timestamptz
  leaseUntil  DateTime?             @map("lease_until") @db.Timestamptz
  lastError   String?               @map("last_error")

  @@index([status, availableAt])
  @@map("file_deletion_jobs")
}

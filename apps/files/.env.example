# Files service environment example.
# Copy this file to `.env` for local development and override values as needed.
# Keep this file free of real credentials, private hosts, and machine-specific secrets.

# gRPC server bind address for the files microservice.
# Format: <host>:<port>
# Use 0.0.0.0 to listen on all network interfaces, or localhost for local-only access.
FILES_GRPC_URL=localhost:50051

# PostgreSQL database used by the Files service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/files

# S3-compatible object storage.
FILES_S3_ENDPOINT=https://storage.yandexcloud.net
FILES_S3_REGION=ru-central1
FILES_S3_BUCKET=your-bucket-name
FILES_S3_ACCESS_KEY_ID=your-static-access-key-id
FILES_S3_SECRET_ACCESS_KEY=your-static-secret-access-key
FILES_S3_PUBLIC_URL=https://pub.storage.yandexcloud.net

# NODE_ENV is selected by the package start scripts.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/files

# gRPC server
FILES_GRPC_URL=localhost:50051

# RabbitMQ: AMQP/AMQPS connection URL, not the management panel URL
AMQPS_URL=amqps://username:password@broker.example.com/vhost

# S3 storage
FILES_S3_ENDPOINT=https://storage.yandexcloud.net
FILES_S3_REGION=ru-central1
FILES_S3_BUCKET=your-bucket-name
FILES_S3_ACCESS_KEY_ID=your-static-access-key-id
FILES_S3_SECRET_ACCESS_KEY=your-static-secret-access-key

# Signed URL lifetime in seconds
FILES_S3_UPLOAD_URL_EXPIRES_IN_SECONDS=300
FILES_S3_DOWNLOAD_URL_EXPIRES_IN_SECONDS=300

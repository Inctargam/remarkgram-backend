generator client {
  provider        = "prisma-client"
  output          = "../src/database/prisma/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  USD
}

enum PeriodUnit {
  DAY
  WEEK
  MONTH
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum WebhookProcessingStatus {
  RECEIVED
  RETRYING
  RECONCILIATION_REQUIRED
  PROCESSED
  IGNORED
  DEAD
}

model Plan {
  id            Int            @id @default(autoincrement())
  price         Int
  currency      Currency       @default(USD)
  periodCount   Int            @default(1) @map("period_count")
  periodUnit    PeriodUnit     @map("period_unit")
  payments      Payment[]
  subscriptions Subscription[]

  @@map("plans")
}

// фиксирует намерение платежа, для локальной подписки служит семантической блокировкой на создание паралельных первых оплат
enum CheckoutPurpose {
  INITIAL_SUBSCRIPTION
  SUBSCRIPTION_EXTENSION
}

// показывает источник финансовой операции и определяет контракт применения успешного платежа.
enum PaymentType {
  PURCHASE // может быть первой покупкой или докупкой.
  RENEWAL // автоматическое списание существующей provider Subscription.
}

model Payment {
  id     String @id @default(uuid()) @db.Uuid
  userId Int    @map("user_id")
  // customerId       String?         @map("customer_id")

  planId      Int        @map("plan_id")
  amount      Int
  currency    Currency
  periodCount Int        @default(1) @map("period_count")
  periodUnit  PeriodUnit @map("period_unit")

  providerCheckoutId     String? @map("provider_checkout_id")
  providerPaymentId      String? @map("provider_payment_id")
  providerSubscriptionId String? @map("provider_subscription_id")
  providerInvoiceId      String? @map("provider_invoice_id")
  providerCustomerId     String? @map("provider_customer_id")

  providerType     PaymentProvider @map("provider_type")
  providerSnapshot Json?           @map("provider_snapshot") @db.JsonB

  idempotentKey        String   @default(uuid()) @map("idempotent_key") @db.Uuid
  subscriptionId       String?  @map("subscription_id") @db.Uuid
  autoRenewalRequested Boolean? @map("auto_renewal_requested")

  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz
  checkoutExpiresAt DateTime?     @map("checkout_expires_at") @db.Timestamptz

  type            PaymentType
  checkoutPurpose CheckoutPurpose? @map("checkout_purpose")

  plan                    Plan                            @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  webhooks                PaymentWebhook[]
  subscriptionApplication SubscriptionPaymentApplication?
  // customer  PaymentCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  //составные ограничения
  @@unique([userId, idempotentKey])
  @@unique([providerType, providerCheckoutId])
  @@unique([providerType, providerPaymentId])
  @@unique([providerType, providerInvoiceId])
  // Первая покупка остается зарезервированной после оплаты, пока локальная подписка
  // не создана и ее идентификатор не сохранен в Payment.
  @@unique([userId], map: "payments_active_initial_subscription_key", where: raw("\"checkout_purpose\" = 'INITIAL_SUBSCRIPTION' AND (\"status\" IN ('CREATED', 'PENDING') OR (\"status\" = 'SUCCEEDED' AND \"subscription_id\" IS NULL))"))
  @@index([planId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([subscriptionId])
  @@index([providerType, providerSubscriptionId])
  // составной индекс для ускорения проверки без полного seq-scan таблицы
  @@index([userId, type, status], map: "payments_blocking_renewal_lookup_idx")
  @@map("payments")
}

model PaymentWebhook {
  id                  String                  @id @default(uuid()) @db.Uuid
  paymentId           String?                 @map("payment_id") @db.Uuid
  providerType        PaymentProvider         @map("provider_type")
  providerEventId     String                  @map("provider_event_id")
  eventType           String                  @map("event_type")
  payload             Json                    @db.JsonB
  providerCreatedAt   DateTime                @map("provider_created_at") @db.Timestamptz
  receivedAt          DateTime                @default(now()) @map("received_at") @db.Timestamptz
  processingStatus    WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  processingAttempts  Int                     @default(0) @map("processing_attempts")
  workflowId          String                  @unique @map("workflow_id")
  processedAt         DateTime?               @map("processed_at") @db.Timestamptz
  processingErrorCode String?                 @map("processing_error_code")
  processingError     String?                 @map("processing_error")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([providerType, providerEventId])
  @@index([paymentId])
  @@index([processingStatus, receivedAt])
  @@index([eventType, receivedAt])
  @@map("payment_webhooks")
}

model PaymentCustomer {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             Int             @map("user_id")
  providerType       PaymentProvider @map("provider_type")
  providerCustomerId String          @map("provider_customer_id")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, providerType])
  @@unique([providerType, providerCustomerId])
  @@index([userId])
  @@map("payment_customers")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
}

enum AutoRenewalStatus {
  DISABLED
  DISABLING
  ENABLED
  ENABLING
  // Автопродление этой provider-связи завершено окончательно; оплаченный доступ сохраняется.
  RETIRED
}

model Subscription {
  id     String @id @default(uuid()) @db.Uuid
  userId Int    @map("user_id")
  planId Int    @map("plan_id")

  startsAt  DateTime           @map("starts_at") @db.Timestamptz
  expiresAt DateTime           @map("expires_at") @db.Timestamptz
  status    SubscriptionStatus

  provider               PaymentProvider
  providerSubscriptionId String?         @map("provider_subscription_id")

  autoRenewalStatus AutoRenewalStatus @default(DISABLED) @map("auto_renewal_status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  plan                        Plan                             @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentApplications         SubscriptionPaymentApplication[] @relation("AppliedSubscription")
  targetAutoRenewalOperations AutoRenewalOperation[]           @relation("AutoRenewalSubscription")
  sourceAutoRenewalOperations AutoRenewalOperation[]           @relation("AutoRenewalSourceSubscription")

  @@unique([provider, providerSubscriptionId])
  @@unique([userId], where: { status: "ACTIVE" })
  @@index([userId, startsAt])
  @@index([status, expiresAt])
  @@index([planId])
  @@map("subscriptions")
}

// Результат применения платежа, а не состояние Subscription.
enum SubscriptionPaymentAction {
  CREATED
  SCHEDULED
  RENEWED
}

// Неизменяемый результат начисления доступа за платёж, сохранённый вместе с изменением Subscription.
// Повтор платежа возвращает этот результат, даже если подписка позднее была продлена снова.
// Неизменяемость полей обеспечивается приложением, а не ограничениями UPDATE в БД.
model SubscriptionPaymentApplication {
  // Один результат на платёж: первичный ключ не позволяет применить тот же платёж повторно.
  paymentId String @id @map("payment_id") @db.Uuid

  // Подписка, созданная или продлённая этим платежом. Несколько платежей могут продлевать одну подписку.
  subscriptionId String @map("subscription_id") @db.Uuid

  // CREATED — создан первый период;
  // RENEWED — продлена существующая подписка;
  // SCHEDULED — создан следующий период и требуется перенос автопродления на новую подписку.
  action SubscriptionPaymentAction

  // Конец оплаченного периода после применения этого платежа: снимок рассчитанного Subscription.expiresAt.
  // CREATED — конец первого периода; RENEWED — конец продлённого; SCHEDULED — конец добавленного в очередь.
  // Для SCHEDULED D1 использует эту дату как billingCycleAnchor для последующих списаний провайдера.
  // Пример: добавлен период 1 декабря — 1 января → paidPeriodEndsAt = 1 января.
  // Не меняется при последующих покупках или продлениях: повтор возвращает исходный результат платежа.
  paidPeriodEndsAt DateTime @map("paid_period_ends_at") @db.Timestamptz

  // Время локального применения платежа; фактическое время оплаты хранится в Payment.paidAt.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscription Subscription @relation("AppliedSubscription", fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Только для SCHEDULED: отдельный изменяемый процесс переноса автопродления.
  // CREATED/RENEWED сохраняют результат без этой операции.
  autoRenewalOperation AutoRenewalOperation?

  @@index([subscriptionId])
  @@map("subscription_payment_applications")
}

enum AutoRenewalOperationType {
  ENABLE
  DISABLE
  TRANSFER
}

enum AutoRenewalOperationStatus {
  ENABLE_PENDING
  DISABLE_PENDING
  BINDING_PENDING
  COMPLETED
}

// Намерение, этап выполнения и результат конкретного изменения автопродления.
// Параметры и связи после создания неизменяемы; меняются status, updatedAt и однократно
// providerSubscriptionId у TRANSFER. Эти правила обеспечивает приложение.
// Завершённая операция хранит историю: поздний повтор не восстанавливает старую настройку Subscription.
model AutoRenewalOperation {
  // Собственный UUID операции, независимый от paymentId. Для TRANSFER создаётся при применении платежа;
  // для ручного изменения устойчиво создаётся внутри DBOS workflow и используется при его повторах.
  id String @id @db.Uuid

  // Владелец операции и ключ общей блокировки: изменения подписок одного пользователя сериализуются.
  userId Int @map("user_id")

  // Неизменяемое намерение: ручное включение/выключение либо перенос автопродления со старой подписки на новую.
  type AutoRenewalOperationType

  // Этап процесса, а не текущее состояние автопродления подписки:
  // ENABLE: ENABLE_PENDING → COMPLETED; DISABLE: DISABLE_PENDING → COMPLETED;
  // TRANSFER: DISABLE_PENDING (старая связь) → BINDING_PENDING (новая связь) → COMPLETED.
  // Если нужная настройка уже установлена, ручная операция не создаётся.
  status AutoRenewalOperationStatus

  // Только TRANSFER: уникальная ссылка на результат применения платежа, по которой распознаётся повтор.
  // Для ручных ENABLE/DISABLE — null. Клиентский ключ идемпотентности здесь не хранится.
  paymentId String? @unique @map("payment_id") @db.Uuid

  // Целевая локальная подписка: изменяемая при ENABLE/DISABLE, новая при TRANSFER. Связь неизменяема.
  subscriptionId String @map("subscription_id") @db.Uuid

  // Провайдер на момент создания операции; при TRANSFER обе provider-подписки относятся к нему.
  provider PaymentProvider

  // ENABLE/DISABLE: неизменяемый снимок существующего provider ID для внешнего вызова.
  // TRANSFER: сначала null, затем один раз сохраняется ID новой provider-подписки при привязке.
  // Сохранённый результат позволяет распознать поздний повтор без чтения текущей привязки Subscription.
  providerSubscriptionId String? @map("provider_subscription_id")

  // Только TRANSFER: старая локальная подписка, у которой отключается автопродление.
  // Её оплаченный период сохраняется. Связь неизменяема; для ручных операций — null.
  sourceSubscriptionId String? @map("source_subscription_id") @db.Uuid

  // Только TRANSFER: неизменяемый снимок старого provider ID для отключения и сверки подтверждения D1.
  // Не перечитывается из Subscription при повторе; для ручных операций — null.
  sourceProviderSubscriptionId String? @map("source_provider_subscription_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Время последнего изменения операции; не является отдельным временем подтверждения провайдером.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  paymentApplication SubscriptionPaymentApplication? @relation(fields: [paymentId], references: [paymentId], onDelete: Restrict, onUpdate: Cascade)
  subscription       Subscription                    @relation("AutoRenewalSubscription", fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceSubscription Subscription?                   @relation("AutoRenewalSourceSubscription", fields: [sourceSubscriptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([subscriptionId])
  @@index([sourceSubscriptionId])
  @@index([userId, status])
  @@map("auto_renewal_operations")
}

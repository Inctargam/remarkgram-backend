generator client {
  provider        = "prisma-client"
  output          = "../src/database/prisma/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  USD
}

enum PeriodUnit {
  DAY
  WEEK
  MONTH
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum WebhookProcessingStatus {
  RECEIVED
  RETRYING
  RECONCILIATION_REQUIRED
  PROCESSED
  IGNORED
  DEAD
}

model Plan {
  id            Int            @id @default(autoincrement())
  price         Int
  currency      Currency       @default(USD)
  periodCount   Int            @default(1) @map("period_count")
  periodUnit    PeriodUnit     @map("period_unit")
  payments      Payment[]
  subscriptions Subscription[]

  @@map("plans")
}

// фиксирует намерение платежа, для локальной подписки служит семантической блокировкой на создание паралельных первых оплат
enum CheckoutPurpose {
  INITIAL_SUBSCRIPTION
  SUBSCRIPTION_EXTENSION
}

// показывает источник финансовой операции и определяет контракт применения успешного платежа.
enum PaymentType {
  PURCHASE // может быть первой покупкой или докупкой.
  RENEWAL // автоматическое списание существующей provider Subscription.
}

model Payment {
  id     String @id @default(uuid()) @db.Uuid
  userId Int    @map("user_id")
  // customerId       String?         @map("customer_id")

  planId      Int        @map("plan_id")
  amount      Int
  currency    Currency
  periodCount Int        @default(1) @map("period_count")
  periodUnit  PeriodUnit @map("period_unit")

  providerCheckoutId     String? @map("provider_checkout_id")
  providerPaymentId      String? @map("provider_payment_id")
  providerSubscriptionId String? @map("provider_subscription_id")
  providerInvoiceId      String? @map("provider_invoice_id")
  providerCustomerId     String? @map("provider_customer_id")

  providerType     PaymentProvider @map("provider_type")
  providerSnapshot Json?           @map("provider_snapshot") @db.JsonB

  idempotentKey        String   @default(uuid()) @map("idempotent_key") @db.Uuid
  subscriptionId       String?  @map("subscription_id") @db.Uuid
  targetSubscriptionId String?  @map("target_subscription_id") @db.Uuid
  autoRenewalRequested Boolean? @map("auto_renewal_requested")

  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz
  checkoutExpiresAt DateTime?     @map("checkout_expires_at") @db.Timestamptz

  type            PaymentType
  checkoutPurpose CheckoutPurpose? @map("checkout_purpose")

  plan                    Plan                            @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  webhooks                PaymentWebhook[]
  subscriptionApplication SubscriptionPaymentApplication?
  // customer  PaymentCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  //составные ограничения
  @@unique([userId, idempotentKey])
  @@unique([providerType, providerCheckoutId])
  @@unique([providerType, providerPaymentId])
  @@unique([providerType, providerInvoiceId])
  // Первая покупка остается зарезервированной после оплаты, пока локальная подписка
  // не создана и ее идентификатор не сохранен в Payment.
  @@unique([userId], map: "payments_active_initial_subscription_key", where: raw("\"checkout_purpose\" = 'INITIAL_SUBSCRIPTION' AND (\"status\" IN ('CREATED', 'PENDING') OR (\"status\" = 'SUCCEEDED' AND \"subscription_id\" IS NULL))"))
  @@index([planId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([subscriptionId])
  @@index([providerType, providerSubscriptionId])
  @@map("payments")
}

model PaymentWebhook {
  id                  String                  @id @default(uuid()) @db.Uuid
  paymentId           String?                 @map("payment_id") @db.Uuid
  providerType        PaymentProvider         @map("provider_type")
  providerEventId     String                  @map("provider_event_id")
  eventType           String                  @map("event_type")
  payload             Json                    @db.JsonB
  providerCreatedAt   DateTime                @map("provider_created_at") @db.Timestamptz
  receivedAt          DateTime                @default(now()) @map("received_at") @db.Timestamptz
  processingStatus    WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  processingAttempts  Int                     @default(0) @map("processing_attempts")
  workflowId          String                  @unique @map("workflow_id")
  processedAt         DateTime?               @map("processed_at") @db.Timestamptz
  processingErrorCode String?                 @map("processing_error_code")
  processingError     String?                 @map("processing_error")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([providerType, providerEventId])
  @@index([paymentId])
  @@index([processingStatus, receivedAt])
  @@index([eventType, receivedAt])
  @@map("payment_webhooks")
}

model PaymentCustomer {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             Int             @map("user_id")
  providerType       PaymentProvider @map("provider_type")
  providerCustomerId String          @map("provider_customer_id")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, providerType])
  @@unique([providerType, providerCustomerId])
  @@index([userId])
  @@map("payment_customers")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
}

enum AutoRenewalStatus {
  DISABLED
  ENABLING
  ENABLED
  DISABLING
  // Автопродление этой provider-связи завершено окончательно; оплаченный доступ сохраняется.
  RETIRED
}

// Результат применения платежа, а не состояние Subscription.
enum SubscriptionPaymentAction {
  CREATED
  SCHEDULED
  RENEWED
}

model Subscription {
  id     String @id @default(uuid()) @db.Uuid
  userId Int    @map("user_id")
  planId Int    @map("plan_id")

  startsAt  DateTime           @map("starts_at") @db.Timestamptz
  expiresAt DateTime           @map("expires_at") @db.Timestamptz
  status    SubscriptionStatus

  provider                       PaymentProvider
  providerSubscriptionId         String?                  @map("provider_subscription_id")

  autoRenewalStatus   AutoRenewalStatus @default(DISABLED) @map("auto_renewal_status")
  // Стабильный ID одного переключения; сохраняется после RETIRED для распознавания повторов.
  autoRenewalChangeId String?           @map("auto_renewal_change_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentApplications SubscriptionPaymentApplication[] @relation("AppliedSubscription")
  outgoingPaymentApplications SubscriptionPaymentApplication[] @relation("PreviousSubscription")

  @@unique([provider, providerSubscriptionId])
  @@unique([userId], where: { status: "ACTIVE" })
  @@index([userId, startsAt])
  @@index([status, expiresAt])
  @@index([planId])
  @@map("subscriptions")
}

enum SubscriptionPaymentProcessingStatus {
  CANCELLATION_PENDING
  BINDING_PENDING
  COMPLETED
}

// Неизменяемый результат applySuccessfulPayment и изменяемый этап обработки операции.
model SubscriptionPaymentApplication {
  paymentId                      String                    @id @map("payment_id") @db.Uuid
  subscriptionId                 String                    @map("subscription_id") @db.Uuid
  // Старая локальная подписка при переносе автопродления; иначе null.
  previousSubscriptionId         String?                   @map("previous_subscription_id") @db.Uuid
  previousProviderSubscriptionId String?                   @map("previous_provider_subscription_id")
  action                         SubscriptionPaymentAction
  processingStatus               SubscriptionPaymentProcessingStatus @map("processing_status")
  // Неизменяемый результат завершающей привязки для поздних повторов SCHEDULED.
  boundProviderSubscriptionId    String?                   @map("bound_provider_subscription_id")
  // Для SCHEDULED — конец всей оплаченной цепочки, включая текущую покупку.
  nextSubscriptionStartsAt       DateTime                  @map("next_subscription_starts_at") @db.Timestamptz
  createdAt                      DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscription Subscription @relation("AppliedSubscription", fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  previousSubscription Subscription? @relation("PreviousSubscription", fields: [previousSubscriptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([subscriptionId])
  @@index([previousSubscriptionId])
  @@map("subscription_payment_applications")
}

# Payments service environment example.

# Copy this file to `.env` for local development and override values as needed.

# Keep this file free of real credentials, private hosts, and machine-specific secrets.

# gRPC server bind address for the payments microservice.

# Format: <host>:<port>

# Use 0.0.0.0 to listen on all network interfaces, or localhost for local-only access.

PAYMENTS_GRPC_URL=localhost:50054

# PostgreSQL database used by the Payments service.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payments

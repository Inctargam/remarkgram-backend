# NODE_ENV is selected by the package start scripts.

# HTTP and frontend
GATEWAY_PORT=3000
BACKEND_API_URL=https://remark-gram.com/api/v1/
FRONTEND_URL=https://dev.remark-gram.com
CORS_ALLOWED_ORIGINS=https://dev.remark-gram.com,https://dev.remark-gram.com:3000

# gRPC clients
FILES_GRPC_URL=localhost:50051
POSTS_GRPC_URL=localhost:50053
USER_ACCOUNTS_GRPC_URL=localhost:50052

# JWT and cookies
JWT_PUBLIC_KEY=change-me
REFRESH_TOKEN_COOKIE_MAX_AGE_MS=1200000

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://remark-gram.com/api/v1/auth/google/callback

# Google reCAPTCHA
GOOGLE_RECAPTCHA_SECRET_KEY=

# GitHub OAuth
GITHUB_CLIENT_ID=github-client-id
GITHUB_CLIENT_SECRET=github-client-secret
GITHUB_CALLBACK_URL=callback-url
GITHUB_API_VERSION='2026-03-10'
GITHUB_USER_AGENT='oauth-test'

# Testing
ENABLE_TESTING_ENDPOINTS=false
TESTING_ENDPOINT_KEY=
SKIP_E2E=true

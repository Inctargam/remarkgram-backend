generator client {
  provider        = "prisma-client"
  output          = "../src/database/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @db.VarChar
  email     String   @db.VarChar
  hash      String?  @db.VarChar
  createdAt DateTime @db.Timestamptz

  isConfirmed            Boolean
  confirmationCode       String?   @db.VarChar
  confirmationExpiration DateTime? @db.Timestamptz

  passwordResetTokens PasswordResetToken[]
  passwordChangedAt   DateTime?            @db.Timestamptz

  deletedAt DateTime? @db.Timestamptz

  sessions DeviceSession[]

  providers AuthIdentity[]

  profile Profile?

  @@unique([username], where: {deletedAt: null})
  @@unique([email], where: {deletedAt: null})

  @@map("users")
}

enum RevokedReason {
  USER_LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  USER_LOCKED
  ADMIN_ACTION
  TOKEN_REUSE_DETECTED
}

model DeviceSession {
  id     String @id @db.Uuid
  userId Int

  deviceName String @db.VarChar
  ip         String @db.VarChar
  jti        String @db.VarChar

  lastActiveAt DateTime @db.Timestamptz
  expiresAt    DateTime @db.Timestamptz

  revokedAt     DateTime?      @db.Timestamptz
  revokedReason RevokedReason?

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("device_sessions")
}

model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId Int

  tokenHash String    @unique @db.VarChar
  createdAt DateTime  @default(now()) @db.Timestamptz
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum AuthProvider {
  github
  google
}

model AuthIdentity {
  id     String @id @default(uuid()) @db.Uuid
  userId Int // relation scalar field (foreign key)

  provider              AuthProvider
  providerSubject       String       @db.VarChar
  providerEmail         String?      @db.VarChar
  providerEmailVerified Boolean      @db.Boolean

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  username  String? @db.VarChar
  avatarUrl String? @db.VarChar

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_identities")
}

model Profile {
  userId      Int       @id @map("user_id")
  firstName   String?   @map("first_name") @db.VarChar
  lastName    String?   @map("last_name") @db.VarChar
  avatarFileId String?  @map("avatar_file_id") @db.Uuid
  avatarUpdateId String? @map("avatar_update_id") @db.Uuid
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  aboutMe     String?   @map("about_me") @db.VarChar
  countryCode String?   @map("country_code") @db.VarChar
  city        String?   @db.VarChar

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model AvatarDeletionRequest {
  userId         Int      @map("user_id")
  idempotencyKey String   @map("idempotency_key") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, idempotencyKey])
  @@map("avatar_deletion_requests")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json      @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")

  @@index([createdAt, id], where: { publishedAt: null })
  @@index([publishedAt])
  @@map("outbox_events")
}

# NODE_ENV is selected by the package start scripts.

# Database
DATABASE_URL=

# DBOS system database: direct or session-pooled connection
USER_ACCOUNTS_DBOS_SYSTEM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_accounts_dbos

# gRPC server and Files client
USER_ACCOUNTS_GRPC_URL=localhost:50052
FILES_GRPC_URL=localhost:50051

# RabbitMQ: AMQP/AMQPS connection URL, not the management panel URL
AMQPS_URL=amqps://username:password@broker.example.com/vhost

# JWT and registration
JWT_PRIVATE_KEY=change-me
ACCESS_TOKEN_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_IN=20m
CONFIRMATION_CODE_EXPIRES_IN=1

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_TOKEN_SECRET=private
PASSWORD_RESET_EMAIL_COOLDOWN_MINUTES=1

# Frontend
FRONTEND_URL=https://remark-gram.com

# Email and SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_LOGIN=
EMAIL_PASSWORD=
EMAIL_FROM=

# gRPC server bind address for the posts microservice.
POSTS_GRPC_URL=localhost:50053

# gRPC target address for the files microservice.
FILES_GRPC_URL=localhost:50051

# PostgreSQL database used by the Posts service.
POSTS_DATABASE_URL="postgresql://postgres:123456@localhost:5432/posts"

# AMQP broker connection used to publish integration events.
# Format: amqps://<username>:<password>@<host>/<vhost>
AMQPS_URL=amqps://username:password@broker.example.com/vhost

# Прямое или session-pooled подключение DBOS к базе данных Posts.
# URL с transaction pooling не подходит для системного подключения DBOS.
POSTS_DBOS_SYSTEM_DATABASE_URL="postgresql://postgres:123456@localhost:5432/posts"

generator client {
  provider        = "prisma-client"
  output          = "../src/infrastructure/prisma/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Post {
  id          Int         @id @default(autoincrement())
  authorId    Int         @map("author_id")
  description String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  images      PostImage[]
  version     Int         @default(0)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz

  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)], map: "posts_author_created_id_active_idx", where: { deletedAt: null })

  @@map("posts")
}

model PostImage {
  fileId   String @id @map("file_id") @db.Uuid
  postId   Int    @map("post_id")
  position Int

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@map("post_images")
}
